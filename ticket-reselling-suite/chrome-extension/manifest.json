{
  "manifest_version": 3,
  "name": "TicketOps Market Intelligence",
  "version": "1.0.0",
  "description": "Passive market data capture for ticket reselling intelligence.",
  "permissions": ["storage", "notifications", "activeTab", "alarms"],
  "host_permissions": [
    "*://*.stubhub.com/*",
    "*://*.ticketmaster.com/*",
    "*://*.vividseats.com/*",
    "*://*.seatgeek.com/*",
    "*://*.etix.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.stubhub.com/*",
        "*://*.ticketmaster.com/*",
        "*://*.vividseats.com/*",
        "*://*.seatgeek.com/*",
        "*://*.etix.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html"
  }
}
