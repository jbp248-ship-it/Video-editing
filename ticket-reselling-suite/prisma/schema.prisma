generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  name        String
  venue       String
  city        String?
  state       String?
  eventDate   DateTime
  category    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory       Inventory[]
  marketSnapshots MarketSnapshot[]

  @@index([eventDate])
  @@index([name])
}

// ─── Inventory (Your Tickets) ────────────────────────────────────────────────

model Inventory {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  section          String
  row              String
  seatFrom         Int
  seatTo           Int
  quantity         Int      @default(1)

  purchasePrice    Float
  purchasePlatform String?
  purchaseDate     DateTime @default(now())

  listPrice        Float?
  listPlatform     String?
  status           String   @default("IN_HAND")

  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sales            Sale[]

  @@index([eventId])
  @@index([status])
  @@index([listPlatform])
}

// ─── Sales ───────────────────────────────────────────────────────────────────

model Sale {
  id             String    @id @default(cuid())
  inventoryId    String
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  platform       String
  salePrice      Float
  quantitySold   Int       @default(1)
  platformFee    Float
  processingFee  Float     @default(0)
  netRevenue     Float
  netProfit      Float

  saleDate       DateTime  @default(now())
  source         String    @default("MANUAL")
  rawEmailData   String?
  confirmed      Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([inventoryId, saleDate])
  @@index([platform])
  @@index([saleDate])
}

// ─── Market Snapshots (Price Intelligence) ───────────────────────────────────

model MarketSnapshot {
  id            String   @id @default(cuid())
  eventId       String?
  event         Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  eventName     String?  // From extension — used to auto-match to eventId later
  platform      String
  section       String?
  getInPrice    Float
  medianPrice   Float?
  averagePrice  Float?
  maxPrice      Float?
  totalListings Int
  totalTickets  Int?

  granularity   String   @default("HOURLY")
  capturedAt    DateTime @default(now())

  @@index([eventId, platform, capturedAt])
  @@index([capturedAt, granularity])
  @@index([eventId, section, platform, capturedAt])
  @@index([eventName])
}

// ─── Alerts ──────────────────────────────────────────────────────────────────

model Alert {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  eventId     String?
  inventoryId String?
  read        Boolean  @default(false)
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([read, dismissed])
  @@index([type])
  @@index([createdAt])
}
