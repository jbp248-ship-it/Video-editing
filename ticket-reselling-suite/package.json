{
  "name": "ticket-reselling-suite",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "setup": "npx prisma generate && npx prisma db push",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "generate-icon": "node scripts/generate-icon.js",
    "electron:build": "node scripts/generate-icon.js && next build && electron-builder --win",
    "postinstall": "npx prisma generate 2>nul || echo done",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "date-fns": "^3.6.0",
    "zod": "^3.23.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.ticketops.desktop",
    "productName": "TicketReselling",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "prisma/schema.prisma",
      "package.json",
      "next.config.js"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": ".prisma"
      },
      {
        "from": "prisma",
        "to": "prisma"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  }
}
