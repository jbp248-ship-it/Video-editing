{
  "name": "chrome-ai-notes",
  "version": "1.0.0",
  "private": true,
  "description": "Offline AI Note Taker Chrome Extension — local Whisper transcription + Gemini Nano summaries",
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/generate-icons.mjs && npm run build",
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "download-model": "node scripts/download-model.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "postinstall": "npm run download-model",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "idb": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.278",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.14",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
